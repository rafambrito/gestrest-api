	"item": [
		{
			"name": "1. Tipos de Usuário",
			"item": [
				{
					"name": "Criar Tipo (DONO)",
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"nome\": \"Dono de Restaurante\"\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": { "raw": "{{base_url}}/api/v1/tipos-usuarios", "host": ["{{base_url}}"], "path": ["api", "v1", "tipos-usuarios"] }
					}
				}
			]
		},
		{
			"name": "2. Usuários",
			"item": [
				{
					"name": "Cadastrar Usuário (Dono)",
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"nome\": \"Rafael Brito\",\n    \"email\": \"rafael@email.com\",\n    \"login\": \"rafael.brito\",\n    \"senha\": \"senha123\",\n    \"endereco\": \"Rua da FIAP, 1000\",\n    \"tipoUsuarioId\": 1\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": { "raw": "{{base_url}}/api/v1/usuarios", "host": ["{{base_url}}"], "path": ["api", "v1", "usuarios"] }
					}
				},
				{
					"name": "Cadastrar Usuário - Email Duplicado (Negativo)",
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"nome\": \"Outro Usuário\",\n    \"email\": \"rafael@email.com\",\n    \"login\": \"outro.login\",\n    \"senha\": \"senha123\",\n    \"endereco\": \"Rua X, 1\",\n    \"tipoUsuarioId\": 1\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": { "raw": "{{base_url}}/api/v1/usuarios", "host": ["{{base_url}}"], "path": ["api", "v1", "usuarios"] }
					},
					"response": [
						{
							"name": "409 - Email duplicado",
							"originalRequest": {},
							"status": "Conflict",
							"code": 409
						}
					]
				}
			]
		},
		{
			"name": "3. Restaurantes",
			"item": [
				{
					"name": "Criar Restaurante",
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"nome\": \"Pizza House\",\n    \"endereco\": \"Av. Paulista, 1100\",\n    \"tipoCozinha\": \"Italiana\",\n    \"horarioFuncionamento\": \"11:00 - 23:00\",\n    \"donoId\": 1\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": { "raw": "{{base_url}}/api/v1/restaurantes", "host": ["{{base_url}}"], "path": ["api", "v1", "restaurantes"] }
					}
				},
				{
					"name": "Criar Restaurante - Deletar com itens (Negativo flow)",
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"nome\": \"Rest Com Itens\",\n    \"endereco\": \"Rua Teste 1\",\n    \"tipoCozinha\": \"Brasileira\",\n    \"horarioFuncionamento\": \"10:00 - 22:00\",\n    \"donoId\": 1\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": { "raw": "{{base_url}}/api/v1/restaurantes", "host": ["{{base_url}}"], "path": ["api", "v1", "restaurantes"] }
					}
				}
			]
		},
		{
			"name": "4. Itens do Cardápio",
			"item": [
