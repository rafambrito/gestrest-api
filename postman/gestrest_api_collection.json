					"name": "Adicionar Item",
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"nome\": \"Pizza Margherita\",\n    \"descricao\": \"Molho de tomate, muzzarela e manjericão\",\n    \"preco\": 45.50,\n    \"restauranteId\": 1\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": { "raw": "{{base_url}}/api/v1/itens-cardapio", "host": ["{{base_url}}"], "path": ["api", "v1", "itens-cardapio"] }
					}
				},
				{
					"name": "Adicionar Item - Restaurante inexistente (Negativo)",
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"nome\": \"Pizza Fantasma\",\n    \"descricao\": \"Não existe restaurante\",\n    \"preco\": 30.00,\n    \"restauranteId\": 999\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": { "raw": "{{base_url}}/api/v1/itens-cardapio", "host": ["{{base_url}}"], "path": ["api", "v1", "itens-cardapio"] }
					},
					"response": [
						{
							"name": "404 - Restaurante não encontrado",
							"originalRequest": {},
							"status": "Not Found",
							"code": 404
						}
